# ============================================================================
# ForgeHub AI — variáveis de ambiente (modelo)
# Copie para .env.local e preencha. NUNCA comite .env.local (chaves reais).
# ============================================================================

# --- Supabase (OBRIGATÓRIO) -------------------------------------------------
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key

# --- Checkout externo da página /oferta (OPCIONAL) --------------------------
# Link do checkout (Kiwify/Hotmart/etc). Se vazio, o CTA cai em /signup.
NEXT_PUBLIC_FORGEHUB_CHECKOUT_URL=

# --- Biblioteca de SKUs / link externo (OPCIONAL) ---------------------------
# Link externo usado pelo hook useSku (grade da biblioteca).
NEXT_PUBLIC_SKU_LIBRARY_URL=

# --- Vídeo de fundo em login/cadastro (OPCIONAL) ----------------------------
# URL de um .mp4 hospedado (Drive/CDN). Se vazio, usa o fundo estático da marca.
NEXT_PUBLIC_AUTH_VIDEO_URL=

# ============================================================================
# APENAS build/dev — NÃO precisa em produção
# ============================================================================
# Geração de imagens dos nichos (scripts/generate-niche-images.ts).
# As 15 imagens já estão versionadas em public/images/niches/, então só é
# necessário se você for regerar arte. Mantenha fora de produção.
OPENAI_API_KEY=
